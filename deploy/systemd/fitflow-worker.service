[Unit]
Description=FitFlow AI/PDF worker (Codex CLI + Playwright)
After=network.target

[Service]
Type=simple
User=fitflow
Group=fitflow
WorkingDirectory=/opt/fitflow/app
EnvironmentFile=/etc/fitflow/fitflow.env
# Codex reads its auth from the worker user's home (or CODEX_HOME)
Environment=HOME=/var/lib/fitflow
ExecStart=/usr/bin/node dist/worker.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fitflow
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=1500M
CPUQuota=150%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fitflow-worker

[Install]
WantedBy=multi-user.target
