# ---------------------------------------------------------------- FitFlow configuration
# Copy to .env (development) or /etc/fitflow/fitflow.env (production). Never commit real secrets.

NODE_ENV=production
# Public base URL (used for secure cookies, PDF QR links, origin checks). https:// in production.
APP_URL=https://fitflow.example.invalid
PORT=3000

# SQLite database file (WAL mode). Keep outside the web root.
DATABASE_PATH=/var/lib/fitflow/fitflow.db
# Private storage (progress photos, generated PDFs). Never under ./public.
STORAGE_DIR=/var/lib/fitflow/storage
# Absolute path to the drizzle/ migrations folder (defaults to ./drizzle relative to cwd).
# MIGRATIONS_DIR=/opt/fitflow/app/drizzle

# Optional random secret (reserved for future signed tokens). Generate: openssl rand -hex 32
SESSION_SECRET=
# Allow additional accounts after the owner account exists (default: false).
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------- AI (Codex CLI)
# codex (default, production) | mock (automated tests / local development only)
AI_PROVIDER=codex
# Path to the Codex CLI binary as seen by the worker's OS user.
CODEX_BIN=/usr/local/bin/codex
# Private working directory for per-job temp files (schema/output). 0700, owned by the worker user.
CODEX_WORKDIR=/var/lib/fitflow/codex-work
# Where Codex keeps its auth for the worker user (defaults to ~/.codex of that user).
# CODEX_HOME=/var/lib/fitflow/.codex
# Optional model override passed as `codex exec -m`.
# CODEX_MODEL=
AI_JOB_TIMEOUT_MS=900000
AI_MAX_CONCURRENT_JOBS=1
AI_MAX_ATTEMPTS=3
# Only for automated E2E tests against a production build. Never set on a real server.
# FITFLOW_ALLOW_MOCK_AI=1

# ---------------------------------------------------------------- PDF
# Chromium used by Playwright for PDFs. Leave empty to use Playwright's managed browser
# (install once: pnpm exec playwright install --with-deps chromium).
CHROMIUM_PATH=

# ---------------------------------------------------------------- Notifications (optional Web Push)
# Generate with: pnpm vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# ---------------------------------------------------------------- Backups & logs
BACKUP_DIR=/var/backups/fitflow
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info
